---
import { MAIN_SITE_URL } from "../lib/site";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-12 max-w-3xl items-center gap-3 px-4 sm:gap-5 md:px-6" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src="/logo.svg" alt="" width="24" height="24" class="h-6 w-6" />
      <span class="text-sm font-semibold tracking-tight text-foreground">Blog</span>
    </a>

    <div class="ml-auto flex items-center gap-1">
      <a
        href={MAIN_SITE_URL}
        class="px-2.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        dq.ms
      </a>
      <a
        href="/rss.xml"
        class="px-2.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        RSS
      </a>
      <button
        type="button"
        data-theme-toggle
        class="ml-1 cursor-pointer border border-border p-1.5 text-muted-foreground transition-colors hover:border-primary/30 hover:text-foreground"
        aria-label="Toggle dark mode"
      >
        <svg class="theme-icon-moon h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <svg class="theme-icon-sun h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const dark = !document.documentElement.classList.contains("dark");
    document.documentElement.classList.toggle("dark", dark);
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
