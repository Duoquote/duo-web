# Hashed assets built by Astro (immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets in public/
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/og.jpg
  Cache-Control: public, max-age=86400

/background.jpg
  Cache-Control: public, max-age=86400

/pp.jpg
  Cache-Control: public, max-age=86400

# Private page. Belt-and-braces alongside the in-page noindex meta and the sitemap
# exclusion; no-referrer keeps the path out of Referer when outbound links are clicked.
/maria
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer

/maria/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer

/maria/*.png
  Cache-Control: public, max-age=86400
